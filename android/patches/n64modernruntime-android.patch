+std::vector<recomp::mods::ModLoadErrorDetails> recomp::mods::ModContext::prepare_rom_patch(
+    const GameEntry& game_entry, const std::string& game_mode_id) {
+    std::vector<recomp::mods::ModLoadErrorDetails> ret{};
+    rom_patch_prepared = false;
+
+    auto find_index_it = mod_game_ids.find(game_entry.mod_game_id);
+    if (find_index_it == mod_game_ids.end()) {
+        ret.emplace_back(game_entry.mod_game_id, ModLoadError::InvalidGame, std::string{});
+        return ret;
+    }
+    const size_t mod_game_index = find_index_it->second;
+
+    size_t rom_patch_mod_index = (size_t)-1;
+    for (size_t mod_index = 0; mod_index < opened_mods.size(); mod_index++) {
+        auto& mod = opened_mods[mod_index];
+        const bool enabled = enabled_mods.contains(mod.manifest.mod_id) ||
+                             auto_enabled_mods.contains(mod.manifest.mod_id);
+        if (!mod.is_for_game(mod_game_index) || !enabled) {
+            continue;
+        }
+        if (mod.manifest.custom_gamemode && game_mode_id != mod.manifest.mod_id) {
+            continue;
+        }
+        if (get_project_version() < mod.manifest.minimum_recomp_version) {
+            ret.emplace_back(mod.manifest.mod_id, ModLoadError::MinimumRecompVersionNotMet,
+                             mod.manifest.minimum_recomp_version.to_string());
+            continue;
+        }
+        if (std::find(mod.content_types.begin(), mod.content_types.end(),
+                      rom_patch_content_type_id) == mod.content_types.end()) {
+            continue;
+        }
+        if (rom_patch_mod_index != (size_t)-1) {
+            ret.emplace_back(mod.manifest.mod_id, ModLoadError::RomPatchConflict,
+                             "conflicts with " + opened_mods[rom_patch_mod_index].manifest.display_name);
+        }
+        else {
+            rom_patch_mod_index = mod_index;
+        }
+    }
+
+    if (!ret.empty() || rom_patch_mod_index == (size_t)-1) {
+        return ret;
+    }
+
+    auto& mod = opened_mods[rom_patch_mod_index];
+    bool patch_exists = false;
+    std::vector<char> patch_data =
+        mod.manifest.file_handle->read_file(std::string{ modpaths::rom_patch_path }, patch_exists);
+    std::vector<uint8_t> patched_rom;
+    if (!patch_exists) {
+        ret.emplace_back(mod.manifest.mod_id, ModLoadError::FailedToLoadPatch, "Internal error");
+        return ret;
+    }
+    auto patch_result = recomp::patcher::patch_rom(
+        recomp::get_rom(),
+        std::span{ reinterpret_cast<const uint8_t*>(patch_data.data()), patch_data.size() },
+        patched_rom);
+    if (patch_result != recomp::patcher::PatcherResult::Success) {
+        ret.emplace_back(mod.manifest.mod_id, ModLoadError::FailedToLoadPatch, std::string{});
+        return ret;
+    }
+    printf("Applying ROM patch early for mod %s\n", mod.manifest.mod_id.c_str());
+    recomp::set_rom_contents(std::move(patched_rom));
+    rom_patch_prepared = true;
+    return ret;
+}
